<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsAotCompatible>true</IsAotCompatible>
		<PackageId>PaddleOcrNet</PackageId>
		<Version>1.0.0</Version>
		<Authors>PaddleOcrNet Contributors</Authors>
		<Description>High-accuracy native .NET OCR powered by PaddleOCR's neural models (DB detection, text-line orientation, SVTR/CRNN recognition) running on ONNX Runtime. No Python required.</Description>
		<PackageTags>OCR;PaddleOCR;ONNX;TextRecognition;DBNet;SVTR;.NET10;AOT</PackageTags>
		<RepositoryUrl>https://github.com/paddleocrnet/PaddleOcrNet</RepositoryUrl>
		<PackageProjectUrl>https://github.com/paddleocrnet/PaddleOcrNet</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<NeutralLanguage>en-US</NeutralLanguage>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<UseWindowsForms>false</UseWindowsForms>
		<UseWPF>false</UseWPF>
		<SupportedOSPlatforms>Windows;Linux;macOS</SupportedOSPlatforms>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="PaddleOcrNet.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<!-- PDFium-based PDF rasterization for the built-in PDF input / searchable-PDF output. -->
		<PackageReference Include="Docnet.Core" Version="2.6.0" />
		<!-- Polygon offsetting (unclip) for DB detection post-processing. Namespace: Clipper2Lib. -->
		<PackageReference Include="Clipper2" Version="2.0.0" />
	</ItemGroup>

</Project>
